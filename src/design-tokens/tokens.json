  "designSystem": "⚡ Quick - v1.2",
  "rules": {
    "colors": "UI components MUST reference colors.semantic (--surface-*, --primary-*, --feedback-*). Never reference colors.primitives or raw hex colors in component styles.",
    "typography": "Use typography.textStyles (Heebo for body and XL/2XL headings; Zalando Sans for 3XL–6XL display headings). Mobile form inputs MUST be at least 16px (Text/Body/base/*).",
    "shadows": "Use shadows (Shadow/SM, Shadow/MD, Shadow/LG, Shadow/XL, Shadow/Focus) mapped 1:1 to Tailwind elevation classes."
  },
