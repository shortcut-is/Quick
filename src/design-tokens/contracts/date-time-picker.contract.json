  "usageGuidelines": {
    "whenToUse": [
      "Use for floating temporal selection panels anchored to `DatePicker` or `TimePicker` triggers across 6 modes: single calendar (`SingleCalendar`), date range with summary pills (`DateRange`), preset shortcuts (`PresetCalendar`), combined date-and-time (`DateAndTime`), 12-hour picker (`TimePicker12h`), and 24-hour duration picker (`TimePicker24h`)."
    ],
    "whenNotToUse": [
      "Do not use as a generic confirmation, form, or profile preview overlay; use `Dialog` or `Card`.",
      "Do not use for brief read-only hover hints; use `Tooltip`.",
      "Do not use for action command lists; use `DropdownMenu`."
    ]
  },
  "behaviorRules": [
    "Anchor smoothly to the invoking trigger (`DatePicker` / `TimePicker`), close on `Escape` or outside click, and manage focus return cleanly using WAI-ARIA `role=\"dialog\"` or grid semantics.",
    "Strict button hierarchy in `PickerFooter`: always pair 1 secondary `Outline XS` action (`Today`, `Reset`, `Cancel`, `Now`) with 1 `Primary XS` confirmation button (`Confirm`, `Apply Range`, `Apply`, `Schedule`), never two `Primary` buttons together."
  ]
