  "usageGuidelines": {
    "whenToUse": [
      "Use to switch between related sibling views inside a page or inside `Topbar` (`Use=DesktopTabs`)."
    ],
    "whenNotToUse": [
      "Do not use as global hierarchical app navigation; use `SidebarNavigation` or `BottomNavigation`.",
      "Do not use for compact 2–3 option toggles inside cards; use `SegmentControl`."
    ]
  },
  "behaviorRules": [
    "Follow WAI-ARIA Tabs pattern (`role=\"tablist\"`, `role=\"tab\"`, `role=\"tabpanel\"`, `ArrowLeft`/`ArrowRight` keyboard switching, `aria-selected`).",
    "Allow horizontal overflow scrolling when tab labels exceed mobile viewport width."
  ]
