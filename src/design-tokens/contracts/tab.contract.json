  "usageGuidelines": {
    "whenToUse": [
      "Para alternar entre vistas o subsecciones hermanas dentro del mismo contexto de página o dentro de `Topbar` (`Use=DesktopTabs`)."
    ],
    "whenNotToUse": [
      "No usar como navegación global de toda la aplicación con jerarquías múltiples; usar `SidebarNavigation` o `BottomNavigation`.",
      "No usar para filtros rápidos compactos de 2–3 opciones dentro de una tarjeta; usar `SegmentControl`."
    ]
  },
  "behaviorRules": [
    "Implementar con `@radix-ui/react-tabs` (`role=\"tablist\"`, `role=\"tab\"`, `role=\"tabpanel\"`).",
    "Navegar horizontalmente con `ArrowLeft` / `ArrowRight` y activar en selección; habilitar scroll horizontal si los ítems desbordan en Mobile."
  ]
