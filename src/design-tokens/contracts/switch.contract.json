  "usageGuidelines": {
    "whenToUse": [
      "Use for binary system preferences that take effect immediately without pressing Save (e.g., notifications, dark mode, developer mode)."
    ],
    "whenNotToUse": [
      "Do not use inside forms requiring explicit Save/Submit or multi-item selection lists; use `Checkbox`.",
      "Do not use to choose between two distinct named values; use `RadioGroup` or `SegmentControl`."
    ]
  },
  "behaviorRules": [
    "Render using `<button role=\"switch\" aria-checked={checked}>` paired with an accessible label via `<label>` or `aria-labelledby`."
