  "usageGuidelines": {
    "whenToUse": [
      "Para activar o desactivar preferencias del sistema con efecto inmediato (`Activar notificaciones`, `Modo oscuro`, `Developer Mode`) sin requerir paso adicional de guardado."
    ],
    "whenNotToUse": [
      "No usar cuando el cambio forma parte de un formulario con botón `Guardar/Enviar` o selección múltiple en listas; usar `Checkbox`.",
