  "usageGuidelines": {
    "whenToUse": [
      "Use as the sticky or fixed top application bar displaying brand, `Breadcrumb` or `Tabs`, `⌘K` search trigger, notifications, and `Avatar` on Desktop (`64px`), or screen title bar (`MobileAppBar` `56px`) on Mobile."
    ],
    "whenNotToUse": [
      "Do not crowd topbars with secondary route links that duplicate `SidebarNavigation`.",
      "Do not confuse with mobile bottom tab bars (`BottomNavigation`)."
    ]
  },
  "behaviorRules": [
    "Render inside semantic `<header>` matching `64px` height on Desktop breakpoints and `56px` height on Mobile breakpoints with Quick v1.2 Tailwind tokens."
  ]
