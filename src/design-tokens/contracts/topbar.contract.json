  "usageGuidelines": {
    "whenToUse": [
      "Como cabecera fija superior de la aplicación para mostrar identidad de marca, `Breadcrumb` o `Tabs`, buscador rápido (`⌘K`), alertas y perfil en Desktop, o cabecera de pantalla en Mobile (`MobileAppBar`)."
    ],
    "whenNotToUse": [
      "No sobrecargar con demasiados enlaces secundarios que compitan con `SidebarNavigation`.",
      "No confundir con la barra de pestañas inferior móvil (`BottomNavigation`)."
    ]
  },
  "behaviorRules": [
    "Renderizar dentro de `<header>` con altura `64px` en Desktop (`DesktopBreadcrumb` / `DesktopTabs`) y `56px` en `MobileAppBar` (`390px`).",
    "Integrar `Breadcrumb`, `Tabs`, disparador de búsqueda con `Kbd` (`⌘K`), notificaciones y `Avatar`."
  ]
