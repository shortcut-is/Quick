  "usageGuidelines": {
    "whenToUse": [
      "Use for mobile horizontal card rails (`MobilePeek`), onboarding slides, featured hero promotions (`HeroBanner`), or multi-card desktop galleries (`WebCards`)."
    ],
    "whenNotToUse": [
      "Do not auto-advance critical reading copy without pause controls; avoid hiding primary product actions solely inside later carousel slides."
    ]
  },
  "behaviorRules": [
    "Use native CSS scroll-snap (`scroll-snap-type: x mandatory`) with `overflow-x: auto` on touch devices (`MobilePeek`), `aria-roledescription=\"carousel\"`, and accessible Prev/Next buttons on desktop."
  ]
