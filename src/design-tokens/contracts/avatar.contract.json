  "usageGuidelines": {
    "whenToUse": [
      "Para representar visualmente a un usuario, miembro de equipo o cuenta mediante foto (`Type=image`), iniciales (`Type=initials`) o letra (`Type=Letter`).",
      "Dentro de `Card` (`Use=Profile`), `Topbar`, `SidebarNavigation`, `ListItem` o `Popover` (`Use=ProfilePreview`)."
    ],
    "whenNotToUse": [
      "No usar como icono genérico de objeto o categoría cuando corresponde un icono de `Icon/Line/*`.",
      "No apilar avatares manualmente con márgenes negativos ad-hoc; usar `AvatarGroup`."
    ]
  },
  "behaviorRules": [
    "Cargar imagen con fallback determinístico a iniciales (`Type=initials`) o letra (`Type=Letter`) usando `Heebo SemiBold` (`FontFamily/Primary`).",
    "Respetar dimensiones exactas por tamaño (`Size`: `24`, `32`, `40`) y radio circular (`Radius/full`).",
    "Incluir atributo `alt` descriptivo cuando `Type=image` y `aria-hidden` en iniciales decorativas junto a texto."
