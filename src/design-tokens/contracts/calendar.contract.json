  "usageGuidelines": {
    "whenToUse": [
      "Use inside `DateTimePicker` (`SingleCalendar`, `DateRange`, `PresetCalendar`, `DateAndTime`), linked from `DatePicker`, or embedded directly in dedicated scheduling views."
    ],
    "whenNotToUse": [
      "Do not embed persistently expanded inside compact forms; use `DatePicker`.",
      "Do not use for selecting time of day; use `TimePicker` or `DateTimePicker` (`TimePicker12h` / `TimePicker24h`)."
    ]
  },
  "behaviorRules": [
    "Implement full WAI-ARIA date-grid keyboard navigation (`ArrowLeft`/`Right`/`Up`/`Down`, `PageUp`/`PageDown` for months, `Home`/`End`).",
    "Support all 6 `_Calendar Days` states: `Default`, `Selected`, `Anchor` (solid primary selection/range endpoints), `Range` (soft continuous range span), `Past Next Day`, and `Disabled`.",
    "Expose configurable `locale` and timezone context when used inside `DatePicker` or `DateTimePicker`."
  ]
