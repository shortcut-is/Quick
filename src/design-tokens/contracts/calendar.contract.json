  "usageGuidelines": {
    "whenToUse": [
      "Use for picking a calendar date inside `Popover` (`Use=DateCalendar`), inside `DatePicker`, or in dedicated scheduling views."
    ],
    "whenNotToUse": [
      "Do not embed persistently expanded inside compact forms; use `DatePicker`.",
      "Do not use for selecting time of day; use `TimePicker`."
    ]
  },
  "behaviorRules": [
    "Implement full WAI-ARIA date-grid keyboard navigation (`ArrowLeft`/`Right`/`Up`/`Down`, `PageUp`/`PageDown` for months, `Home`/`End`).",
    "Visually distinguish today, selected day (`Primary/Top..Bottom`), out-of-month muted days, and disabled dates.",
    "Expose configurable `locale` and timezone context when used inside `DatePicker` or `Popover`."
  ]
