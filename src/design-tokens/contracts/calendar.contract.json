  "usageGuidelines": {
    "whenToUse": [
      "Use across all 4 variants: compact inline monthly grid (`Use=Default`), single-date selection card with header and Today/Confirm actions (`Use=Single`), two-endpoint date-range card with range summary pills (`Use=Range`), and two-column quick-preset calendar (`Use=Presets`)."
    ],
    "whenNotToUse": [
      "Do not embed persistently expanded inside compact forms; use `DatePicker` as the compact trigger.",
      "Do not use for selecting time of day; use `TimePicker`."
    ]
  },
  "behaviorRules": [
    "Implement full WAI-ARIA date-grid keyboard navigation (`ArrowLeft`/`Right`/`Up`/`Down`, `PageUp`/`PageDown` for months, `Home`/`End`).",
    "Support all 6 `_Calendar Days` states: `Default`, `Selected`, `Anchor` (solid primary selection/range endpoints), `Range` (soft continuous range span), `Past Next Day`, and `Disabled`.",
    "Strict button hierarchy in card footers (`Single`, `Range`, `Presets`): always pair 1 secondary `Outline XS` button (`Today`, `Reset`, `Cancel`) with 1 `Primary XS` confirmation button (`Confirm`, `Apply Range`, `Apply`), never two `Primary` buttons together."
  ]
}
