  "usageGuidelines": {
    "whenToUse": [
      "Para decisiones críticas o bloqueantes que exigen atención inmediata (`Use=Destructive`), confirmaciones importantes o formularios cortos centrados (`SM` `380px`, `MD` `460px`).",
      "Combinar en el footer siempre un botón primario (`Primary` o `Destructive`) con uno secundario (`Outline` o `Ghost` para `Cancel`)."
    ],
    "whenNotToUse": [
      "No usar dos botones `Primary` simultáneos dentro del `DialogFooter`; la acción de cancelar o descartar siempre debe usar `Outline` o `Ghost`.",
      "No usar en paneles extensos de filtros, inspectores laterales o flujos táctiles en mobile; usar `Sheet` (`Right (Web)` o `Bottom (Mobile)`).",
      "No usar para mensajes breves que no requieren bloquear la UI; usar `Toast` o `Alert`.",
      "No usar para controles rápidos anclados a un botón; usar `Popover`."
    ]
  },
  "behaviorRules": [
    "Implementar con `@radix-ui/react-dialog` (o `@radix-ui/react-alert-dialog` cuando `Use=Destructive`).",
    "Atrapar el foco dentro del modal mientras esté abierto, cerrar con `Escape` y devolver el foco al trigger al cerrar.",
    "Combinar siempre con `OVERLAY`; usar `Size=SM` (`380px`) para confirmaciones breves y `Size=MD` (`460px`) para formularios.",
    "Jerarquía obligatoria de acciones en `DialogFooter`: nunca usar dos botones `Primary` juntos; combinar siempre 1 botón secundario (`Outline` o `Ghost` para `Cancel`) + 1 botón de confirmación (`Primary` en `Default`/`Form`, o `Destructive` en `Use=Destructive`)."
  ]
}
