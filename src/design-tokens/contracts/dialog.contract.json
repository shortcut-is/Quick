  "usageGuidelines": {
    "whenToUse": [
      "Use for critical or blocking decisions demanding immediate attention (`Use=Destructive`), important confirmations, or short focused forms (`SM` `380px`, `MD` `460px`).",
      "Always pair 1 main confirmation button (`Primary` or `Destructive`) with 1 secondary button (`Outline` or `Ghost` for `Cancel`) inside `DialogFooter`."
    ],
    "whenNotToUse": [
      "Never place two `Primary` buttons side by side in `DialogFooter`; cancel/dismiss must always use `Outline` or `Ghost`.",
      "Do not use for wide multi-field inspectors, filter drawers, or mobile-native bottom panels; use `Sheet` (`Right (Web)` or `Bottom (Mobile)`).",
      "Do not use for brief non-blocking notices; use `Toast` or `Alert`.",
      "Do not use for calendar or time selection pickers; use `DateTimePicker`."
    ]
  },
  "behaviorRules": [
    "Implement using semantic `role=\"dialog\"` (or `role=\"alertdialog\"` for `Use=Destructive`), `aria-modal=\"true\"`, `aria-labelledby`, and `aria-describedby`.",
    "Trap keyboard focus while open, close on `Escape`, and restore focus to the invoking trigger upon close.",
    "Always pair over `Overlay`; use `SM` (`380px`) for short confirmations and `MD` (`460px`) for forms.",
    "Mandatory footer button hierarchy: never render two `Primary` buttons side by side; always combine 1 secondary button (`Outline` or `Ghost` for `Cancel`) with 1 confirmation button (`Primary` for `Default`/`Form`, or `Destructive` for `Use=Destructive`)."
  ]
