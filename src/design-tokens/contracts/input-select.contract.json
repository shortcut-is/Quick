  "usageGuidelines": {
    "whenToUse": [
      "En formularios o filtros cuando el usuario debe seleccionar una opción única dentro de una lista cerrada (habitualmente 4 o más opciones)."
    ],
    "whenNotToUse": [
      "No usar si hay solo 2–3 opciones cortas siempre visibles que conviene comparar de un vistazo; usar `RadioGroup` o `SegmentControl`.",
      "No usar para disparar menús de comandos o acciones; usar `DropdownMenu`."
    ]
  },
  "behaviorRules": [
    "Implementar con `@radix-ui/react-select` o `<select>` estilizado accesible con navegación por teclado completa.",
    "Vincular `Hint` mediante `aria-describedby` cuando `hasHint` es true y marcar `aria-invalid` en `State=Error`.",
    "Soportar estados `Default`, `Filled`, `Hover`, `Focus`, `Error` y `Disabled`."
  ]
