  "usageGuidelines": {
    "whenToUse": [
      "Use inside forms or filters when choosing a single value from a closed list of 4 or more options."
    ],
    "whenNotToUse": [
      "Do not use when only 2–3 short options exist that benefit from immediate visibility; use `RadioGroup` or `SegmentControl`.",
