  "usageGuidelines": {
    "whenToUse": [
      "Use for structured inputs requiring static unit/protocol addons (`https://`, `.quick.ds`, currency `$ USD`, phone country code `Flag / Mexico`), password visibility toggles, or attached Copy/Apply actions."
    ],
    "whenNotToUse": [
      "Do not use when only a plain single-line field or single leading icon is needed; use `InputText`."
    ]
  },
  "behaviorRules": [
    "Render the internal `<input>` at 16px (`Text/Body/base/normal`) and `44px` container height (`spacing/11`) to meet mobile touch comfort and avoid iOS zoom.",
    "Expose `aria-pressed` on the password visibility toggle button and clear accessible labels on joined action controls."
  ]
