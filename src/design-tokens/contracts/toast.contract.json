  "usageGuidelines": {
    "whenToUse": [
      "Use for transient non-blocking status feedback after user actions (`Saved`, `Copied`, temporary network errors) with optional `Undo` action and close button."
    ],
    "whenNotToUse": [
      "Do not use for persistent form validation errors users need to reference while editing; use `Alert`.",
      "Do not use when an immediate blocking decision is required; use `Dialog`."
    ]
  },
  "behaviorRules": [
    "Render inside an accessible live region (`aria-live=\"polite\"` for `Neutral`/`Success`, `aria-live=\"assertive\"` for `Danger`).",
    "Pause auto-dismiss timers on hover or keyboard focus and cap simultaneous visible toasts."
  ]
