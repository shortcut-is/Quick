  "usageGuidelines": {
    "whenToUse": [
      "Para feedback transitorio no bloqueante tras completar una acción (`Cambios guardados`, `Enlace copiado`, `Error de red temporal`) con cierre opcional o botón `Undo`."
    ],
    "whenNotToUse": [
      "No usar para errores críticos de validación que el usuario deba consultar mientras edita un formulario; usar `Alert`.",
      "No usar cuando se requiera decisión obligatoria; usar `Dialog`."
    ]
  },
  "behaviorRules": [
    "Implementar con `@radix-ui/react-toast` o `sonner`, anunciado vía `aria-live=\"polite\"` (`Neutral`/`Success`) o `assertive` (`Danger`).",
    "Respetar límite simultáneo en viewport (`<= 3` toasts) y pausar el auto-dismiss al hacer hover o foco."
  ]
