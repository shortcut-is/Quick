  "usageGuidelines": {
    "whenToUse": [
      "Use inside a `role=\"radiogroup\"` container when users choose between prominent plans, shipping methods, or payment options."
    ],
    "whenNotToUse": [
      "Use `RadioButton` for compact inline form choices and `ListItem` (`leading=\"Radio\"`) for full-width list rows."
    ]
  },
  "behaviorRules": [
    "Render as `<label>` wrapping native `<input type=\"radio\">` so clicking anywhere on the card selects the option with keyboard and focus-ring parity."
  ]
