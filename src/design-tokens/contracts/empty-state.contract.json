  "usageGuidelines": {
    "whenToUse": [
      "Cuando una tabla, listado o vista no contiene elementos iniciales (`Use=Default`), una búsqueda no arroja resultados (`Use=Search`) o falló la carga completa de datos (`Use=Error`)."
    ],
    "whenNotToUse": [
      "No usar mientras los datos siguen cargando; usar `Skeleton` o `Spinner`.",
      "No usar para advertencias puntuales dentro de contenido ya cargado; usar `Alert`."
    ]
  },
  "behaviorRules": [
    "Usar `Use=Default` para listados vacíos iniciales, `Use=Search` cuando no hay coincidencias de filtro y `Use=Error` con CTA de reintento tras fallo.",
    "Mantener layout de acciones con `flex-wrap` para adaptarse limpiamente entre Desktop y Mobile.",
    "Cuando muestre acción principal y secundaria (`hasSecondaryAction=true`), usar 1 botón `Primary` y 1 `Outline`/`Ghost`, nunca dos botones `Primary` juntos."
  ]
