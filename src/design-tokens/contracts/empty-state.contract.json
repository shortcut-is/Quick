  "usageGuidelines": {
    "whenToUse": [
      "Use when a table, list, or workspace has zero initial items (`Use=Default`), a search/filter returns no matches (`Use=Search`), or data loading failed (`Use=Error`)."
    ],
    "whenNotToUse": [
      "Do not use while data is still loading; use `Skeleton` or `Spinner`.",
      "Do not use for inline warnings alongside populated content; use `Alert`."
    ]
  },
  "behaviorRules": [
    "Keep action bar responsive with flex wrapping so buttons stack cleanly across Desktop and Mobile breakpoints.",
    "When displaying both primary and secondary actions (`hasSecondaryAction=true`), always pair 1 `Primary` button with 1 `Outline`/`Ghost` button, never two `Primary` buttons together."
