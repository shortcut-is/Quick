  "usageGuidelines": {
    "whenToUse": [
      "Use to display a known determinate completion percentage or storage/quota ratio (`0–100%`) with semantic state (`Default`, `Success`, `Warning`, `Danger`)."
    ],
    "whenNotToUse": [
      "Do not use for unknown wait durations; use `Spinner` or `Skeleton`.",
      "Do not use as an interactive input control; use `Slider`."
    ]
  },
  "behaviorRules": [
    "Implement using semantic `role=\"progressbar\"` with `aria-valuenow`, `aria-valuemin=\"0\"`, and `aria-valuemax=\"100\"`.",
    "In code, bind `Indicator` width continuously (`width: ${value}%`) using Quick v1.2 Tailwind gradient/status tokens rather than limiting to the 3 visual Figma presets (`25%`, `75%`, `100%`)."
