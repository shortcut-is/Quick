  "usageGuidelines": {
    "whenToUse": [
      "Para indicar porcentaje conocido y determinado de avance, carga de archivo o consumo de cuota/almacenamiento (`0–100%`) con semántica (`Default`, `Success`, `Warning`, `Danger`)."
    ],
    "whenNotToUse": [
      "No usar si la duración o el porcentaje exacto es desconocido; usar `Spinner` o `Skeleton`.",
      "No usar como control manipulable por el usuario para elegir un valor; usar `Slider`."
    ]
  },
  "behaviorRules": [
    "Implementar con `@radix-ui/react-progress` o `role=\"progressbar\"` con `aria-valuenow`, `aria-valuemin=\"0\"` y `aria-valuemax=\"100\"`.",
    "En código, `value` es continuo (`0..100`) y controla el ancho porcentual de `Indicator` (`width: ${value}%`), sin limitarse a los 3 presets visuales (`25%`, `75%`, `100%`).",
    "Usar `Use=Default` para progreso estándar y `Success`/`Warning`/`Danger` para cuotas, umbrales o alertas."
  ]
