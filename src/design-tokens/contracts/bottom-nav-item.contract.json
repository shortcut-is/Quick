  "usageGuidelines": {
    "whenToUse": [
      "Use exclusively inside `BottomNavigation` to independently control each tab's state (`Default`, `Hover`, `Active`), label, and `20×20` icon."
    ],
    "whenNotToUse": [
      "Do not use standalone outside `BottomNavigation` or inside forms; use `Button` or `TabItem`."
    ]
  },
  "behaviorRules": [
    "Ensure a minimum touch target of `48×48px` (`72×52px` base box) and mark the active destination with `aria-current=\"page\"`.",
    "Apply `Surfaces/Muted` pill on `Hover`, adding `1px` `Surfaces/Border` stroke and `Surfaces/Foreground` styling on `Active`."
