  "usageGuidelines": {
    "whenToUse": [
      "Use in scheduling or booking forms where users pick a structured 24-hour (`HH:MM:SS`) or 12-hour (`HH:MM AM/PM`) time via `_TimePicker Elements`."
    ],
    "whenNotToUse": [
      "Do not use for calendar date picking; use `DatePicker` or `Calendar`."
    ]
  },
  "behaviorRules": [
    "Support both `Format=24h` (`00:00:00`) and `Format=12h` (`09:30 AM/PM`) across `_TimePicker Elements` states (`Default`, `Filled`, `Active` with `Shadow/Focus`, `Error` with `Feedback/Danger`).",
    "Support full keyboard numeric entry, arrow increment/decrement, and AM/PM period switching, pairing with `DateTimePicker` (`TimePicker12h` / `TimePicker24h`) when preset slots or duration chips are needed."
  ]
