  "usageGuidelines": {
    "whenToUse": [
      "Use inside `RadioGroup` when selecting exactly one option from 2 to 5 mutually exclusive choices with label and optional description.",
      "Use `RadioCard` for prominent pricing or plan tiles, or `ListItem` (`leading=\"Radio\"`) inside scrollable list containers."
    ],
    "whenNotToUse": [
      "Do not use when multiple items can be active simultaneously; use `Checkbox`.",
      "Do not use for long option lists (more than 5 items); use `InputSelect` or `Combobox`."
    ]
  },
  "behaviorRules": [
    "Participate in `RadioGroup` roving tabindex and arrow-key selection (`ArrowUp`/`ArrowDown` or `ArrowLeft`/`ArrowRight`)."
  ]
