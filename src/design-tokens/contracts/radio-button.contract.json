  "usageGuidelines": {
    "whenToUse": [
      "Siempre dentro de `RadioGroup` cuando el usuario debe elegir exactamente una opción de entre 2 a 5 alternativas mutuamente excluyentes con etiqueta y descripción opcional."
    ],
    "whenNotToUse": [
      "No usar si se pueden marcar varias opciones simultáneamente; usar `Checkbox`.",
      "No usar cuando hay muchas opciones que alargarían demasiado el formulario; usar `InputSelect`."
    ]
