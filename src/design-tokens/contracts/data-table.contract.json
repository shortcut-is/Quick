  "usageGuidelines": {
    "whenToUse": [
      "Use to display structured tabular datasets across multiple comparable columns with sorting, bulk row selection (`Selectable`), row actions, and pagination (`DataTableFooter`)."
    ],
    "whenNotToUse": [
      "Do not force multi-column tables onto narrow mobile screens without adapting to `ListItem` rows or horizontal scrolling; for simple 2–3 field collections prefer `Card` (`Use=List`)."
    ]
  },
  "behaviorRules": [
    "Render semantic HTML `<table>`, `<thead>`, `<tbody>`, `<tfoot>` in Desktop views and adapt cleanly to `ListItem` cards or horizontal scroll on Mobile using Quick v1.2 Tailwind tokens.",
    "Keep `density`, visible columns (`Col 1..8` / `Cell 1..8`), `isSelectable`, and `hasActions` synchronized between `DataTableHeader` and `DataTableRow`.",
    "Maintain accurate `aria-sort` attributes on sortable header cells."
  ]
}
