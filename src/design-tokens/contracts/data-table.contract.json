  "usageGuidelines": {
    "whenToUse": [
      "Para mostrar conjuntos estructurados de registros tabulares con múltiples columnas comparables, ordenación (`_Data table Header Cell`), selección masiva (`Selectable`) y paginación (`DataTableFooter`)."
    ],
    "whenNotToUse": [
      "No usar en viewports estrechos de mobile sin adaptación a filas tipo tarjeta (`ListItem`); ni para colecciones de 2–3 campos simples que lucen mejor en `Card` (`Use=List`)."
    ]
  },
  "behaviorRules": [
    "Implementar con `@tanstack/react-table` combinando tabla semántica (`<table>`, `<thead>`, `<tbody>`, `<tfoot>`) en Desktop y tarjetas `ListItem` o scroll horizontal en Mobile.",
    "Sincronizar `density`, columnas visibles (`Col 1..8` / `Cell 1..8`), `isSelectable` y `hasActions` entre `DataTableHeader` y `DataTableRow`.",
    "Mantener `aria-sort` actualizado en `_Data table Header Cell` cuando `sortDirection` esté activo."
  ]
}
