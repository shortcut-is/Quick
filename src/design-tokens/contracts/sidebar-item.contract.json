  "usageGuidelines": {
    "whenToUse": [
      "Como enlace de navegación unitario dentro de `SidebarNavigation`, cubriendo tanto `Mode=Expanded` como `Mode=Collapsed` con estados `Default`, `Hover` y `Active`."
    ],
    "whenNotToUse": [
      "No usar en barras horizontales superiores (`TabItem`) ni dentro de `BottomNavigation` (`BottomNavItem`)."
    ]
