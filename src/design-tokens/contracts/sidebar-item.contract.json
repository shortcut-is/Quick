  "usageGuidelines": {
    "whenToUse": [
      "Use as individual route rows/tiles inside `SidebarNavigation`, supporting both `Expanded` (`216×40px`) and `Collapsed` (`40×40px`) modes across `Default`, `Hover`, and `Active`."
    ],
    "whenNotToUse": [
      "Do not use in top horizontal tabs (`TabItem`) or mobile bottom bars (`BottomNavItem`)."
    ]
  },
  "behaviorRules": [
    "Mark active destination with `aria-current=\"page\"`.",
    "In `Mode=Collapsed`, hide label/badge/chevron and expose the route name via `aria-label` and optional `Tooltip`."
  ]
