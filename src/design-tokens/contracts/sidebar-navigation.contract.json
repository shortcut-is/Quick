  "usageGuidelines": {
    "whenToUse": [
      "Use as the primary vertical application sidebar on Desktop dashboards (`Expanded` `248px` or collapsed icon-rail `72px`) combining brand header, route groups, counts, mode switch, and user profile."
    ],
    "whenNotToUse": [
      "Do not keep fixed open on narrow mobile viewports; hide inside a slide-over `Sheet` or replace with `BottomNavigation` + `Topbar` (`MobileAppBar`)."
    ]
  },
  "behaviorRules": [
    "Wrap in `<aside><nav aria-label=\"Main Navigation\">` keeping exactly one route active (`State=Active`) while inactive items remain in `State=Default`."
  ]
