  "usageGuidelines": {
    "whenToUse": [
      "Como estructura de navegación vertical principal en dashboards y aplicaciones web (`Expanded` `248px` o `Collapsed` `72px`), con soporte para marca, grupos de rutas, badge de conteo y perfil."
    ],
    "whenNotToUse": [
      "No renderizar fija en pantalla en viewports móviles; en Mobile ocultarla dentro de `Sheet` o reemplazar por `BottomNavigation` + `Topbar` (`MobileAppBar`)."
    ]
  },
  "behaviorRules": [
    "Envolver navegación principal en `<aside><nav aria-label=\"Main Navigation\">` marcando la ruta activa con `aria-current=\"page\"`.",
    "Permitir alternancia entre `Mode=Expanded` (`248px`) y `Mode=Collapsed` (`72px`); en viewport móvil `< 768px` desplegar dentro de `Sheet`."
