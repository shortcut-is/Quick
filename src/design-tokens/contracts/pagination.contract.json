  "usageGuidelines": {
    "whenToUse": [
      "Use to navigate numbered pages across large record sets and inside `DataTableFooter`."
    ],
    "whenNotToUse": [
      "Do not use for hierarchical path orientation (`Breadcrumb`), sibling page tabs (`Tabs`), or sequential wizards (`Stepper`)."
    ]
  },
  "behaviorRules": [
    "Wrap in `<nav aria-label=\"Pagination\">` marking the active page button with `aria-current=\"page\"`.",
    "Disable `Previous` and `Next` controls at boundary pages and condense large ranges with ellipsis (`More`)."
  ]
