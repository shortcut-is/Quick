  "usageGuidelines": {
    "whenToUse": [
      "Para mostrar controles flotantes no modales anclados a un botón: filtros rápidos (`Use=Filter`), selector de fecha (`Use=DateCalendar` con `Calendar`), vista previa de perfil (`Use=ProfilePreview`) o ajustes breves."
    ],
    "whenNotToUse": [
      "No usar para texto breve meramente informativo al hacer hover; usar `Tooltip`.",
      "No usar para listas simples de comandos; usar `DropdownMenu`.",
      "No usar cuando el contenido sea extenso o requiera foco modal completo; usar `Dialog` o `Sheet`."
    ]
  },
  "behaviorRules": [
    "Anclar al disparador mediante posicionamiento flotante y cerrar al presionar `Escape` o hacer clic fuera.",
    "Preferir `Use=DateCalendar` junto con `Calendar` para selectores de fecha contextuales.",
    "En `PopoverFooter`, combinar siempre 1 botón secundario (`Outline XS`) con 1 botón principal (`Primary XS`), nunca dos botones `Primary` simultáneos."
  ]
