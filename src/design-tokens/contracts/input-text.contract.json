  "usageGuidelines": {
    "whenToUse": [
      "Para capturar cadenas cortas de una sola línea (texto, email, URL, credenciales, búsqueda) con etiqueta, icono opcional y texto de ayuda o error."
    ],
    "whenNotToUse": [
      "No usar para párrafos o texto multilínea; usar `Textarea` (`Input Area`).",
      "No usar para listas cerradas de opciones; usar `InputSelect`."
    ]
  },
  "behaviorRules": [
    "Renderizar `<input>` asociado a `<label>` mediante `htmlFor`, con soporte para icono opcional (`hasIcon`) y texto de ayuda/error (`hasHint`).",
    "En `State=Error`, aplicar `aria-invalid=\"true\"` y vincular `Hint Text` mediante `aria-describedby`.",
    "Mantener mínimo `16px` en mobile para prevenir zoom automático en iOS."
  ]
