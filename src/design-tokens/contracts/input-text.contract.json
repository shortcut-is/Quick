  "usageGuidelines": {
    "whenToUse": [
      "Use to capture single-line text values (name, email, URL, credentials, search) with label, optional leading icon, and helper/error hint."
    ],
    "whenNotToUse": [
      "Do not use for multi-line paragraphs; use `Textarea` (`Input Area`).",
      "Do not use for closed option lists; use `InputSelect`."
    ]
