  "usageGuidelines": {
    "whenToUse": [
      "Use for compact read-only metadata, semantic statuses (`Success`, `Warning`, `Danger`, `Info`), version tags (`v1.2`), or unread counts.",
      "Use attached inside `Card`, table cells, `SidebarItem`, or `Popover` headers."
    ],
    "whenNotToUse": [
      "Do not use for clickable actions or route navigation; use `Button`.",
      "Do not use for removable filter chips with a dismiss button; use `Tag` or `TagGroup`.",
      "Do not use for keyboard shortcut hints; use `Kbd`."
    ]
  },
  "behaviorRules": [
    "Keep text single-line (`whitespace-nowrap`) matching Figma `HUG` behavior so labels never wrap or clip.",
    "Choose `Use` purely by semantic intent (`Bold`/`Subtle`/`Outline` neutral; `Info`/`Success`/`Warning`/`Danger` for states).",
    "Render a circular status dot before the label when `Type=Dot`."
