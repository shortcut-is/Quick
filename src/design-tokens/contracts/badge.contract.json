  "usageGuidelines": {
    "whenToUse": [
      "Para mostrar metadatos breves de solo lectura, estados (`Success`, `Warning`, `Danger`, `Info`) o contadores numéricos (`v1.2`, `4`, `Active`).",
      "Como indicador visual adjunto en tarjetas, filas de tabla, `SidebarItem` o encabezados de `Popover`."
    ],
    "whenNotToUse": [
      "No usar para acciones clicables ni navegación; usar `Button`.",
      "No usar para filtros removibles o selecciones que el usuario pueda descartar con `×`; usar `Tag` o `TagGroup`.",
      "No usar para atajos de teclado; usar `Kbd`."
    ]
  },
  "behaviorRules": [
    "Mantener texto en una sola línea (`whitespace-nowrap`, `HUG` en Figma) para evitar truncamiento o saltos inesperados.",
    "Elegir `Use` según semántica (`Bold` / `Subtle` / `Outline` neutros; `Info` / `Success` / `Warning` / `Danger` para estados).",
