  "usageGuidelines": {
    "whenToUse": [
      "Para avisos ricos persistentes o bandeja de alertas con título, detalle y acción opcional que el usuario puede descartar manualmente."
    ],
    "whenNotToUse": [
      "No usar para confirmaciones efímeras que desaparecen solas tras pocos segundos; usar `Toast`.",
      "No usar para errores inline dentro de formularios; usar `Alert`."
