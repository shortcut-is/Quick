  "usageGuidelines": {
    "whenToUse": [
      "Use to group cohesive information or self-contained modules in dashboard grids, compact forms (`Use=Form`), settings (`Use=Settings`), KPI metrics (`Use=Stat`), lists (`Use=List`), or pricing plans (`Use=Pricing`)."
    ],
    "whenNotToUse": [
      "Do not use for blocking or overlay workflows; use `Dialog` or `Sheet`.",
      "Do not use when records need multi-column sorting and bulk selection; use `DataTable`.",
      "Avoid nesting `Card` inside another `Card` with double borders and shadows."
    ]
  },
  "behaviorRules": [
    "Follow composable structure (`Card`, `CardHeader`, `CardTitle`, `CardDescription`, `CardContent`, `CardFooter`) styled with Quick v1.2 Tailwind CSS surface, radius, and shadow tokens.",
    "Preserve concentric border radii between outer container (`radius/xl|2xl|3xl`) and inner `Slot: Content` or media containers.",
    "In `CardFooter`, maintain strict hierarchy of 1 `Primary` action paired with 1 secondary action (`Outline`/`Ghost`), never two `Primary` buttons together."
  ]
