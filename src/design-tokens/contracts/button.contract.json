  "usageGuidelines": {
    "whenToUse": [
      "Use to trigger actions or commands (`Save`, `Deploy`, `Cancel`, `Delete`), submit forms, or open overlays such as `Dialog`, `Sheet`, or `DateTimePicker`.",
      "Use `Primary` for the single main action in a view/block, `Outline` for secondary actions, `Ghost` for subtle tools/dismiss buttons, and `Destructive` for irreversible deletions."
    ],
    "whenNotToUse": [
      "Never place two `Primary` buttons side by side or use multiple `Primary` buttons inside a `Dialog`, `Sheet`, `Card`, or `DateTimePicker`: always pair 1 main action (`Primary` or `Destructive`) with 1 secondary button (`Outline` or `Ghost` for `Cancel`/`Reset`).",
      "Do not use to display static status labels or counts; use `Badge`.",
      "Do not use for persistent binary settings; use `Switch` or `Checkbox`.",
      "Do not use for top-level app navigation; use `SidebarNavigation`, `Topbar`, `BottomNavigation`, or `Tabs`."
    ]
  },
  "behaviorRules": [
    "Strict action-pair hierarchy: never place two `Primary` buttons side by side inside the same container or footer (`Dialog`, `Sheet`, `Card`, `DateTimePicker`); always combine 1 main action (`Primary` or `Destructive`) with 1 secondary button (`Outline` or `Ghost`).",
    "Support all interactive states (`Default`, `Hover`, `Focus` with accessible focus ring, and native `Disabled` attribute) styled with Quick v1.2 Tailwind CSS theme tokens.",
    "When `Content=Icon`, an accessible `aria-label` is mandatory since no visible text label is rendered.",
    "Map `Variant=Primary` fills to `Primary/Top` → `Primary/Bottom` and foreground to `Primary/Foreground`."
  ]
