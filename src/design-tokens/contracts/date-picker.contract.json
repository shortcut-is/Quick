  "usageGuidelines": {
    "whenToUse": [
      "Use in forms when users need to select a single calendar date (`Use=Single`), a start-to-end range (`Use=Range`), or a combined date and time (`Use=DateTime`) through a compact trigger paired with `Calendar`."
    ],
    "whenNotToUse": [
      "Do not use when an always-visible inline calendar grid is required; use `Calendar`.",
      "Do not use for standalone time entry; use `TimePicker`."
    ]
  },
  "behaviorRules": [
    "Compose an `InputText` trigger (`Single`, `Range`, or `DateTime` in `Default` or `Filled` state) paired with `Calendar` on Desktop or bottom `Sheet` on touch devices.",
    "Support `Escape` dismissal, keyboard clear/edit, trailing `Calendar` icon affordance, and locale-aware formatting."
  ]
