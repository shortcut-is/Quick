  "usageGuidelines": {
    "whenToUse": [
      "En formularios o listas donde el usuario puede elegir cero, una o varias opciones independientes, o aceptar términos/confirmaciones que requieren pulsar Guardar/Enviar."
    ],
    "whenNotToUse": [
      "No usar cuando las opciones son mutuamente excluyentes; usar `RadioButton` / `RadioGroup` o `InputSelect`.",
      "No usar para activar o desactivar configuraciones de efecto inmediato en el sistema; usar `Switch`."
    ]
  },
  "behaviorRules": [
    "Asociar `<label>` explícitamente al control mediante `htmlFor` / `id` y soportar estado indeterminado (`indeterminate`).",
    "Acompañar errores de validación con `aria-invalid` y mensaje descriptivo vinculado por `aria-describedby`.",
    "Soportar los estados `Unchecked`, `Checked` e `Indeterminate` en combinación con `Enabled`, `Hover`, `Focus`, `Disabled` y `Error`."
  ]
