  "usageGuidelines": {
    "whenToUse": [
      "Use in forms or lists where users can select zero, one, or multiple independent options, or confirm an agreement prior to submitting."
    ],
    "whenNotToUse": [
      "Do not use for mutually exclusive options; use `RadioButton` / `RadioGroup` or `InputSelect`.",
      "Do not use for instant system preferences that apply immediately without Save; use `Switch`."
    ]
  },
  "behaviorRules": [
    "Use native `<input type=\"checkbox\">` or WAI-ARIA `role=\"checkbox\"` with explicit `<label htmlFor>` association and `indeterminate` state support.",
    "Bind `aria-invalid=\"true\"` and `aria-describedby` to validation helper text when `State=Error`.",
    "Support `Unchecked`, `Checked`, and `Indeterminate` across `Enabled`, `Hover`, `Focus`, `Disabled`, and `Error` states."
