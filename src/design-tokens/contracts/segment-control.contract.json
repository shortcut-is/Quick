  "usageGuidelines": {
    "whenToUse": [
      "Para alternar de forma compacta entre 2 y 5 modos, vistas o escalas paralelas dentro de una misma tarjeta o barra de herramientas (`Mensual` / `Anual`, `Lista` / `Grid`)."
    ],
    "whenNotToUse": [
      "No usar como navegación de nivel superior entre páginas diferentes o secciones con gran cantidad de opciones; usar `Tabs`, `SidebarNavigation` o `InputSelect`."
    ]
  },
  "behaviorRules": [
    "Implementar con `role=\"radiogroup\"` o `@radix-ui/react-toggle-group` (`type=\"single\"`) para cambio inmediato de vista o filtro.",
    "Asegurar que exactamente un segmento tenga estado activo con fondo `Surfaces/Background` y sombra `Shadow 1`."
  ]
