  "usageGuidelines": {
    "whenToUse": [
      "Use strictly for concise supplemental text labels (icon-button names, brief hints, keyboard shortcuts) triggered by hover or keyboard focus."
    ],
    "whenNotToUse": [
      "Never place interactive buttons, links, or form inputs inside `Tooltip` (touch devices cannot hover); use `Dialog`, `Sheet`, or `DropdownMenu`.",
      "Do not hide validation errors inside a tooltip; use inline copy or `Alert`."
    ]
  },
  "behaviorRules": [
    "Use `role=\"tooltip\"` linked via `aria-describedby`, opening on both pointer hover and keyboard focus and dismissing on `Escape`."
  ]
