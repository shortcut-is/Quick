  "usageGuidelines": {
    "whenToUse": [
      "Para orientar al usuario dentro de jerarquías de navegación profundas (3 o más niveles), habitualmente en el `Topbar` (`Use=DesktopBreadcrumb`) o encabezado de página."
    ],
    "whenNotToUse": [
      "No usar como sustituto de navegación principal ni para flujos secuenciales paso a paso; usar `Tabs`, `SidebarNavigation` o `Stepper`.",
      "No mostrar si la arquitectura tiene un solo nivel."
    ]
  },
  "behaviorRules": [
    "Envolver en `<nav aria-label=\"Breadcrumb\">` con lista ordenada `<ol>` y enlaces `<a>` para cada nivel previo.",
    "El último nivel visible debe marcarse con `aria-current=\"page\"` y no renderizar separador final (`>`).",
    "En mobile, colapsar niveles intermedios manteniendo primer nivel o botón de retroceso."
  ]
