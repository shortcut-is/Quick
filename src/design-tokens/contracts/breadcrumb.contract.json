  "usageGuidelines": {
    "whenToUse": [
      "Use to orient users within hierarchical architectures of 3 or more levels, typically inside `Topbar` (`Use=DesktopBreadcrumb`) or page headers."
    ],
    "whenNotToUse": [
      "Do not use as primary app navigation or linear multi-step progress; use `SidebarNavigation`, `Tabs`, or `Stepper`.",
      "Do not display when the hierarchy is only one level deep."
    ]
  },
  "behaviorRules": [
    "Wrap in `<nav aria-label=\"Breadcrumb\">` containing an ordered `<ol>` list of links.",
    "Mark the current leaf level with `aria-current=\"page\"` and hide its trailing `>` separator.",
    "On narrow mobile screens, collapse intermediate levels or switch to the back button inside `Topbar` (`MobileAppBar`)."
  ]
