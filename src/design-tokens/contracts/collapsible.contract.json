  "usageGuidelines": {
    "whenToUse": [
      "Use for a single standalone expandable block (sidebar filter group with `Variant=Ghost`, or advanced settings section with `Variant=Card`)."
    ],
    "whenNotToUse": [
      "Do not stack multiple independent collapsibles where an organized FAQ or multi-item disclosure belongs; use `Accordion`."
    ]
  },
