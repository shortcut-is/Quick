  "usageGuidelines": {
    "whenToUse": [
      "Use `Position=Right (Web)` (`360px`) on Desktop for side inspectors, multi-field edit forms, or slide-over filters without leaving page context.",
      "Use `Position=Bottom (Mobile)` on touch devices as the standard bottom drawer with drag handle and full-width `MD` actions."
    ],
    "whenNotToUse": [
      "Do not use for short centered confirmations or urgent destructive prompts; use `Dialog`.",
      "Do not use for lightweight trigger-anchored controls of 2–4 fields on Desktop; use `Popover`."
    ]
  },
  "behaviorRules": [
    "Always pair over `Overlay`, render `role=\"dialog\"` with `aria-modal=\"true\"`, trap focus while open, and close on `Escape`.",
    "Strict button hierarchy in `SheetFooter`: always combine 1 secondary button (`Outline` for `Cancel`/`Reset`) with 1 `Primary` action button; never render two `Primary` buttons together."
  ]
