  "usageGuidelines": {
    "whenToUse": [
      "En Desktop (`Position=Right (Web)`) para formularios de edición laterales, paneles de detalle o filtros avanzados sin abandonar la vista principal.",
      "En Mobile (`Position=Bottom (Mobile)`) como hoja inferior estándar con *drag handle* para menús, filtros o formularios táctiles."
    ],
    "whenNotToUse": [
      "No usar para alertas de confirmación rápidas ni mensajes de dos líneas; usar `Dialog`.",
      "No usar para menús ligeros de 2–4 campos anclados a un disparador en Desktop; usar `Popover`."
    ]
  },
  "behaviorRules": [
    "Emparejar siempre con `OVERLAY`, atrapar foco dentro del panel mientras esté abierto y cerrar con `Escape`.",
    "Usar `Position=Right (Web)` (`360px`) en escritorio para inspectores, formularios o filtros; usar `Position=Bottom (Mobile)` con `DragHandle` y botones `MD` a ancho completo en touch.",
    "En `SheetFooter`, respetar la jerarquía de 1 botón secundario (`Outline` para `Cancel`/`Reset`) + 1 botón principal (`Primary` para confirmar/aplicar); nunca colocar dos botones `Primary` juntos."
  ]
