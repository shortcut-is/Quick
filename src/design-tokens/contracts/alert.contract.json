  "usageGuidelines": {
    "whenToUse": [
      "Para mostrar feedback persistente dentro de la página sobre el estado del sistema, errores de formulario o advertencias contextuales (`Neutral`, `Success`, `Warning`, `Danger`).",
      "Cuando el mensaje requiere permanecer visible mientras el usuario lee o corrige la vista actual."
    ],
    "whenNotToUse": [
      "No usar para confirmaciones efímeras tras guardar o copiar; usar `Toast`.",
      "No usar cuando se requiera bloquear al usuario y exigir una confirmación explícita; usar `Dialog`."
    ]
  },
  "behaviorRules": [
    "Usar `role=\"alert\"` para avisos críticos (`Use=Danger` / `Warning`) o `role=\"status\"` para mensajes informativos (`Neutral` / `Success`).",
    "En flujos de confirmación destructiva bloqueante, combinar con Dialog / AlertDialog.",
    "Ocultar `ActionsWrapper` mediante `hasActions={false}` cuando el aviso sea puramente informativo.",
    "Cuando `ActionsWrapper` muestre dos botones (`hasSecondaryAction=true`), usar un único botón principal y uno secundario (`Outline`/`Ghost`), nunca dos botones `Primary` juntos."
  ]
