  "usageGuidelines": {
    "whenToUse": [
      "Use for persistent in-page feedback communicating system status, form validation summaries, warnings, or danger notices (`Neutral`, `Success`, `Warning`, `Danger`).",
      "Use when the message must stay visible while the user reads or resolves the surrounding context."
    ],
    "whenNotToUse": [
      "Do not use for brief transient confirmations after saving or copying; use `Toast`.",
      "Do not use when blocking user input and demanding explicit confirmation; use `Dialog`."
    ]
  },
  "behaviorRules": [
    "Use `role=\"alert\"` for urgent notices (`Warning` / `Danger`) and `role=\"status\"` for informational or success feedback (`Neutral` / `Success`).",
    "Hide `ActionsWrapper` via `hasActions={false}` for purely informational banners.",
    "Strict button hierarchy: when showing two actions (`hasSecondaryAction=true`), always pair 1 main action button (`Primary`/`Destructive`) with 1 secondary button (`Outline`/`Ghost`), never two `Primary` buttons together."
  ]
